{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/about.json: la home",
  "description": "data/about.json: lo que sale en la home (la portada). VS Code lee este fichero (por el \"$schema\" de arriba del JSON) para autocompletar, explicar cada campo y subrayar lo que está mal; el build y la vista previa lo usan para revisar.",
  "type": "object",
  "required": [
    "description",
    "subtitle",
    "links",
    "bio",
    "cv",
    "services",
    "contact"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_": {
      "type": "string"
    },
    "description": {
      "description": "Lo que sale debajo del nombre en Google.",
      "anyOf": [
        {
          "type": "string",
          "description": "El mismo en los tres idiomas."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ca"
          ],
          "description": "Uno por idioma: { \"ca\": …, \"es\": …, \"en\": … }",
          "properties": {
            "ca": {
              "type": "string",
              "description": "En catalán."
            },
            "es": {
              "type": "string",
              "description": "En castellano (si falta, sale el catalán)."
            },
            "en": {
              "type": "string",
              "description": "En inglés (si falta, sale el catalán)."
            }
          }
        }
      ]
    },
    "subtitle": {
      "description": "Las líneas debajo del nombre, una por línea.",
